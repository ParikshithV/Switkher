---
import Layout from '../layouts/Layout.astro';
import Switcher from '../components/Switcher.astro';

const downloadURL = 'https://github.com/ParikshithV/Switkher/releases/latest';
const repoURL = 'https://github.com/ParikshithV/Switkher';

const features = [
	{
		title: 'Every window, every Space',
		body: 'Switkher indexes windows across all of your Spaces and displays, including minimized ones, so nothing is out of reach.',
		icon: 'M3 5h8v6H3zM13 5h8v6h-8zM3 13h8v6H3zM13 13h8v6h-8z',
	},
	{
		title: 'Tabs are first-class',
		body: 'Browser and app tabs show up right alongside windows. Press → on any window to expand its tabs and jump straight to one.',
		icon: 'M3 7h6l2-3h10v16H3zM3 7v13',
	},
	{
		title: 'Search that forgives typos',
		body: 'Fuzzy matching across window titles and app names. Type “xc sw” and land on SwitcherView.swift in Xcode.',
		icon: 'M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.5 15.5 21 21',
	},
	{
		title: 'Favorites on a letter',
		body: 'Give your most-used apps a letter. Hit it in the switcher to bring up their last window, or launch them if they aren’t running.',
		icon: 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z',
	},
	{
		title: 'Just hold a key',
		body: 'Hold Option, Command, Control or fn on its own to summon the switcher. Tune the delay so it never fights your other shortcuts.',
		icon: 'M4 8h16v10H4zM8 12h8',
	},
	{
		title: 'Replace ⌘Tab, if you like',
		body: 'Flip one switch and Switkher takes over ⌘Tab, cycling windows instead of apps. Turn it off and macOS is back to normal.',
		icon: 'M4 12h13M13 7l5 5-5 5',
	},
];

const shortcuts = [
	{ keys: ['⌥', '⇥'], label: 'Cycle through recent windows — release to switch' },
	{ keys: ['⌥', 'Space'], label: 'Open search across every window and tab' },
	{ keys: ['Hold ⌥'], label: 'Long-press a modifier to open the switcher' },
	{ keys: ['1', '–', '9'], label: 'Jump straight to a numbered row' },
	{ keys: ['A', '–', 'Z'], label: 'Open a favorite app by its letter' },
	{ keys: ['→'], label: 'Expand a window to see its tabs' },
];
---

<Layout>
	<div class="glow" aria-hidden="true"></div>

	<header class="nav container">
		<a href="/" class="brand">
			<img src="/favicon.png" width="28" height="28" alt="" />
			Switkher
		</a>
		<nav>
			<a href="#features">Features</a>
			<a href="#shortcuts">Shortcuts</a>
			<a href="#privacy">Privacy</a>
			<a href={downloadURL} class="button small">Download</a>
		</nav>
	</header>

	<main>
		<section class="hero container">
			<img class="hero-icon" src="/icon.png" width="128" height="128" alt="Switkher app icon" />
			<h1>
				Every window. Every tab.<br />
				<span class="gradient-text">One keystroke away.</span>
			</h1>
			<p class="lede">
				Switkher is a keyboard-first window and tab switcher for macOS. Search everything you have open, jump to it instantly, and
				never hunt through a pile of windows again.
			</p>
			<div class="cta">
				<a href={downloadURL} class="button">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
						><path
							fill="currentColor"
							d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.7-4.1zM13.9 4.9c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z"
						></path></svg
					>
					Download for macOS
				</a>
				<a href={repoURL} class="button ghost">View on GitHub</a>
			</div>
			<p class="requirements">Requires macOS 14 Sonoma or later</p>

			<div class="demo">
				<div class="demo-hint">
					<span>Try it — type to search, use</span>
					<kbd>↑</kbd><kbd>↓</kbd>
					<span>and</span>
					<kbd>↩</kbd>
				</div>
				<Switcher />
			</div>
		</section>

		<section id="features" class="container section">
			<h2>Built for people who live on the keyboard</h2>
			<p class="section-lede">Everything you’d expect from ⌘Tab, plus everything it’s been missing.</p>
			<div class="grid">
				{
					features.map((f) => (
						<article class="card">
							<svg class="card-icon" viewBox="0 0 24 24" aria-hidden="true">
								<path d={f.icon} />
							</svg>
							<h3>{f.title}</h3>
							<p>{f.body}</p>
						</article>
					))
				}
			</div>
		</section>

		<section id="shortcuts" class="container section">
			<h2>Shortcuts you’ll learn in a minute</h2>
			<p class="section-lede">All of them are customizable from the menu bar.</p>
			<ul class="shortcuts">
				{
					shortcuts.map((s) => (
						<li>
							<span class="keys">{s.keys.map((k) => (k === '–' ? <span class="dash">–</span> : <kbd>{k}</kbd>))}</span>
							<span>{s.label}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section id="privacy" class="container section privacy">
			<div class="card wide">
				<svg class="card-icon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z M9 12l2 2 4-4" />
				</svg>
				<div>
					<h3>Everything stays on your Mac</h3>
					<p>
						Switkher uses the macOS Accessibility API to see your windows and tabs and switch between them. It makes no network
						requests, collects no analytics, and has no account to sign up for. It lives quietly in your menu bar and launches at
						login.
					</p>
				</div>
			</div>
		</section>

		<section id="download" class="container section final">
			<img src="/icon.png" width="96" height="96" alt="" />
			<h2>Stop hunting for windows.</h2>
			<p class="section-lede">Grant Accessibility access once, then press <kbd>⌥</kbd> <kbd>Space</kbd>.</p>
			<div class="cta">
				<a href={downloadURL} class="button">Download Switkher</a>
			</div>
			<p class="requirements">macOS 14 Sonoma or later</p>
		</section>
	</main>

	<footer class="container footer">
		<span>© {new Date().getFullYear()} Parikshith V</span>
		<a href={repoURL}>GitHub</a>
	</footer>
</Layout>

<style>
	.glow {
		position: absolute;
		inset: 0 0 auto;
		height: 900px;
		pointer-events: none;
		background:
			radial-gradient(600px 380px at 50% 520px, rgba(229, 84, 111, 0.22), transparent 70%),
			radial-gradient(700px 420px at 30% 620px, rgba(236, 138, 74, 0.16), transparent 70%),
			radial-gradient(900px 500px at 70% 300px, rgba(110, 72, 160, 0.35), transparent 70%);
		z-index: -1;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 72px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 650;
		text-decoration: none;
	}

	.brand img {
		border-radius: 7px;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 26px;
		font-size: 15px;
	}

	nav a:not(.button) {
		color: var(--muted);
		text-decoration: none;
		transition: color 0.15s;
	}

	nav a:not(.button):hover {
		color: var(--text);
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 13px 22px;
		border-radius: 99px;
		background: var(--text);
		color: var(--bg);
		font-weight: 600;
		font-size: 16px;
		text-decoration: none;
		transition:
			transform 0.15s,
			box-shadow 0.15s;
	}

	.button:hover {
		transform: translateY(-1px);
		box-shadow: 0 10px 30px -8px rgba(236, 138, 74, 0.6);
	}

	.button.small {
		padding: 7px 16px;
		font-size: 14px;
	}

	.button.ghost {
		background: var(--surface);
		color: var(--text);
		border: 1px solid var(--border);
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-top: 56px;
	}

	.hero-icon {
		width: 128px;
		height: 128px;
		filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.6));
		animation: float 6s ease-in-out infinite;
	}

	@keyframes float {
		50% {
			transform: translateY(-8px);
		}
	}

	h1 {
		margin: 28px 0 0;
		font-size: clamp(40px, 7vw, 72px);
		line-height: 1.04;
		letter-spacing: -0.035em;
		font-weight: 750;
	}

	.lede {
		max-width: 620px;
		margin: 24px 0 0;
		font-size: 19px;
		color: var(--muted);
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 34px;
	}

	.requirements {
		margin: 14px 0 0;
		font-size: 14px;
		color: var(--faint);
	}

	.demo {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		margin-top: 72px;
	}

	.demo-hint {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		color: var(--faint);
	}

	.section {
		padding-top: 140px;
		text-align: center;
	}

	h2 {
		margin: 0;
		font-size: clamp(30px, 4.5vw, 44px);
		letter-spacing: -0.025em;
		line-height: 1.1;
		font-weight: 700;
	}

	.section-lede {
		margin: 14px 0 0;
		color: var(--muted);
		font-size: 18px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 16px;
		margin-top: 56px;
		text-align: left;
	}

	.card {
		padding: 28px;
		border-radius: var(--radius);
		background: var(--surface);
		border: 1px solid var(--border);
		transition:
			border-color 0.2s,
			background 0.2s;
	}

	.card:hover {
		border-color: rgba(244, 207, 107, 0.3);
		background: rgba(255, 255, 255, 0.055);
	}

	.card h3 {
		margin: 18px 0 8px;
		font-size: 19px;
		font-weight: 650;
	}

	.card p {
		margin: 0;
		color: var(--muted);
		font-size: 16px;
	}

	.card-icon {
		width: 40px;
		height: 40px;
		padding: 9px;
		border-radius: 11px;
		background: linear-gradient(135deg, var(--plum), #2a1f38);
		fill: none;
		stroke: var(--yellow);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
	}

	.grid .card:nth-child(3n + 2) .card-icon {
		stroke: var(--orange);
	}

	.grid .card:nth-child(3n) .card-icon {
		stroke: var(--pink);
	}

	.shortcuts {
		list-style: none;
		max-width: 720px;
		margin: 48px auto 0;
		padding: 8px;
		border-radius: var(--radius);
		background: var(--surface);
		border: 1px solid var(--border);
		text-align: left;
	}

	.shortcuts li {
		display: flex;
		align-items: center;
		gap: 20px;
		padding: 14px 18px;
		color: var(--muted);
	}

	.shortcuts li + li {
		border-top: 1px solid var(--border);
	}

	.keys {
		display: flex;
		align-items: center;
		gap: 5px;
		flex: none;
		width: 160px;
		color: var(--text);
	}

	.dash {
		color: var(--faint);
	}

	.privacy .card.wide {
		display: flex;
		gap: 24px;
		align-items: flex-start;
		max-width: 820px;
		margin: 0 auto;
		text-align: left;
	}

	.privacy .card-icon {
		flex: none;
		width: 52px;
		height: 52px;
		padding: 12px;
	}

	.privacy h3 {
		margin-top: 4px;
		font-size: 24px;
	}

	.final {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-bottom: 40px;
	}

	.final img {
		margin-bottom: 24px;
		filter: drop-shadow(0 16px 30px rgba(0, 0, 0, 0.6));
	}

	.footer {
		display: flex;
		justify-content: space-between;
		padding: 40px 0;
		margin-top: 80px;
		border-top: 1px solid var(--border);
		color: var(--faint);
		font-size: 14px;
	}

	.footer a {
		text-decoration: none;
	}

	.footer a:hover {
		color: var(--text);
	}

	@media (max-width: 640px) {
		nav a:not(.button) {
			display: none;
		}
		.shortcuts li {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
		}
		.privacy .card.wide {
			flex-direction: column;
		}
		.section {
			padding-top: 100px;
		}
	}
</style>
